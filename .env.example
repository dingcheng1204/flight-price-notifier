# Copy to .env and fill in for local development:  cp .env.example .env
# Vite inlines VITE_* variables into the browser bundle at build time, so only public values belong here.
# Production/preview values are set in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (project URL and the *publishable* key — never a secret/service_role key)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Optional: override the AWS API Gateway base URL (defaults to production)
# VITE_FLIGHT_API_URL="https://<api-id>.execute-api.us-east-1.amazonaws.com"
